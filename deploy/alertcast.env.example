# /etc/alertcast/alertcast.env — права 600, власник root.
# Після змін: sudo systemctl restart alertcast

# Де alertd (локальний API). http — лише для адрес цього сервера.
ALERTD_URL=http://127.0.0.1:8788

# Публічний вхід: reverse proxy (напр. https://alerts.example.com) → сюди.
PUBLIC_LISTEN=127.0.0.1:8790
# Звідки брати справжню адресу клієнта на публічному вході:
#   cf     — CF-Connecting-IP, якщо до proxy з'єднався вузол Cloudflare (інакше — адреса з'єднання з proxy);
#   xff    — останній запис X-Forwarded-For (його ставить сам proxy);
#   remote — адреса з'єднання (без proxy).
PUBLIC_IP_SOURCE=cf

# Окремий вхід лише для VPN (напр. https://alerts-vpn.example.com → сюди). Порожньо — вимкнено.
VPN_LISTEN=
VPN_IP_SOURCE=xff
# 1 — приймати ?token=… і на VPN-вході (лише якщо журнал proxy не пише query-рядок).
VPN_ALLOW_QUERY=0

# Адмінка (пароль + 2FA): лише loopback; назовні — через VPN-сайт панелі → сюди. off — вимкнено.
# Вхід налаштовується командою: sudo alertcast admin setup
ADMIN_LISTEN=127.0.0.1:8793
ADMIN_IP_SOURCE=xff

# Публічна адреса — для «alertcast check» і для QR-коду нового токена.
PUBLIC_URL=https://alerts.example.com

# Через скільки без підтвердження стану з API ukrainealarm дані вважаються застарілими (stale).
STALE_AFTER=5m

# Типові обмеження нового токена (змінюються для кожного токена окремо).
DEFAULT_RPM=60
DEFAULT_STREAMS=2

# Захист: потоків загалом і з однієї адреси; запитів на хвилину з однієї адреси (до перевірки
# токена); блокування адреси після AUTH_FAIL_LIMIT невдалих спроб за AUTH_FAIL_WINDOW на AUTH_BAN.
MAX_STREAMS=2000
MAX_STREAMS_PER_IP=20
IP_RPM=300
AUTH_FAIL_LIMIT=10
AUTH_FAIL_WINDOW=10m
AUTH_BAN=15m
# Скільки регіонів можна запитати одним запитом.
MAX_REGIONS=64

# Назва вкладки браузера на публічних сторінках. Порожньо — нейтральний заголовок.
SITE_TITLE=
